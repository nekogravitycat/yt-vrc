# Deployment-specific facts and anything sensitive. Copy to .env and
# fill in -- .env is gitignored, never committed. A real environment
# variable always wins over this file (see internal/infra/config).
#
# Tunable, non-sensitive behavior (quality caps, timeouts, gate, cache,
# resolve limits, ...) lives in config.yaml instead -- see
# config.example.yaml.

# The public URL VRChat/AVPro will fetch media from. Required for real
# use; the localhost default only works for same-machine testing.
PUBLIC_BASE_URL=https://example.com

# For a Cloudflare Tunnel deployment (see CLAUDE.md), bind loopback
# only -- cloudflared always connects to the origin over localhost, so
# the process never needs to accept LAN/WAN connections. Leaving this
# at the :8080 (all-interfaces) default means anyone who can reach the
# host directly bypasses the tunnel and can spoof CF-Connecting-IP to
# impersonate ADMIN_IPS.
# LISTEN_ADDR=127.0.0.1:8080
# DATA_DIR=./data

# External tool locations -- differ per machine (e.g. ffmpeg from winget
# lives behind a shim directory on Windows; Docker sets its own paths).
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# YTDLP_PATH=yt-dlp

# "path" (use YTDLP_PATH as-is) or "managed" (versioned dir + /u hot
# upgrade). Containers must set managed.
# YTDLP_MODE=path
# Release asset name when YTDLP_MODE=managed, e.g. yt-dlp.exe. Never
# yt-dlp_linux on Alpine (glibc, won't run on musl).
# YTDLP_ASSET=
# yt-dlp only enables the deno JS runtime by default; the Docker image
# sets this to node since it ships nodejs instead.
# YTDLP_JS_RUNTIMES=

# Optional egress proxy for resolve traffic only (socks5:// or http://,
# may embed credentials). Media downloads never go through this.
# RESOLVER_PROXY=

# Required for the Discord presence gate; both must be set before source
# registration.
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=

# Client IPs allowed to run /on /off /p /d /u /mode /l /e /i.
# Empty means unrestricted.
# ADMIN_IPS=1.1.1.1

# IPs allowed by /mode/whitelist; separate from ADMIN_IPS to avoid
# granting admin access.
# WHITELIST_IPS=1.1.1.1

# Dev-only stand-in for a real availability signal. Unset by default;
# set true/false to bypass Discord presence entirely during development.
# FAKE_SIGNAL_ONLINE=true
