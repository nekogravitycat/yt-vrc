PUBLIC_BASE_URL=https://example.com

# Required for the Discord presence gate; both must be set before source registration.
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=
# DISCORD_ACTIVITY_NAME=VRChat

# Client IPs allowed to run /on /off /p /d /u /mode.
# Empty means unrestricted.
# ADMIN_IPS=1.1.1.1

# IPs allowed by /mode/whitelist; separate from ADMIN_IPS to avoid granting admin access.
# WHITELIST_IPS=1.1.1.1