# Copy to .env (gitignored) and fill in. Anything already set in the
# real environment wins, so a container's env is never overridden by a
# file that happened to be baked into the image.

# Discord presence signal (spec §4.4.2). Both are required before the
# source is registered at all; with neither set the gate is fail-closed
# and only /on opens it.
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=
# DISCORD_ACTIVITY_NAME=VRChat
